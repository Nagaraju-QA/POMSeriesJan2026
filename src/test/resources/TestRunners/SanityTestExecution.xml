<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Trading App Test Regression Suite" verbose="4" thread-count="3"
	parallel="tests">

	<listeners>
		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<listener class-name="com.qa.Trading.listeners.TestAllureListener" />
		<listener class-name="com.qa.Trading.listeners.AnnotationTransformer" />
	</listeners>

	<test name="Login Page Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="123.0" />
		<parameter name="testname" value="Login Page Test" />

		<classes>
			<class name="com.qa.Trading.tests.LoginPageTest" />
		</classes>
	</test>

	<test name="Login Page Test_firefox">
		<parameter name="browser" value="firefox" />
		<parameter name="browserversion" value="105.0" />
		<parameter name="testname" value="Login Page Test" />
		<classes>
			<class name="com.qa.Trading.tests.LoginPageTest" />
		</classes>
	</test>

		<test name="Login Page Test_edge">
		<parameter name="browser" value="edge" />
		<parameter name="browserversion" value="105.0" />
		<parameter name="testname" value="Login Page Test" />
		<classes>
			<class name="com.qa.Trading.tests.LoginPageTest" />
		</classes>
	</test>	

</suite>