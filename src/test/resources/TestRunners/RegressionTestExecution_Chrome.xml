<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Trading App Test Regression Suite" verbose="4" thread-count="3" parallel="tests">
	
	<listeners>
		<listener class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<listener class-name="com.qa.Trading.listeners.TestAllureListener" />
		<listener class-name="com.qa.Trading.listeners.AnnotationTransformer" />
	</listeners>
	
	<test name="Account Page Test">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="123.0" />
		<parameter name="testname" value="Account Page Test" />
		<classes>
			<class name="com.qa.Trading.tests.AccountsPageTest" />
		</classes>
	</test>

	<test name="Login Page Test">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="123.0" />
		<parameter name="testname" value="Login Page Test" />
		<classes>
			<class name="com.qa.Trading.tests.LoginPageTest" />
		</classes>
	</test>
	
	<test name="Product Info Test">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="123.0" />
		<parameter name="testname" value="Product Info Test" />
		<classes>
			<class name="com.qa.Trading.tests.ProductInfoPageTest" />
		</classes>
	</test>

	<test name="Register Page Test">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="123.0" />
		<parameter name="testname" value="Register Page Test" />
		<classes>
			<class name="com.qa.Trading.tests.RegisterPageTest" />
		</classes>
	</test>

	<test name="Search Results Test">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="123.0" />
		<parameter name="testname" value="Search Results Tests" />
		<classes>
			<class name="com.qa.Trading.tests.SearchResultsPageTest" />
		</classes>
	</test>

</suite>